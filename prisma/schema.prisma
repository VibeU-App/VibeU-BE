// Prisma schema for VibeU backend
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// Account status enum values
enum AccountStatusName {
  PENDING
  ACTIVE
  INACTIVE
  TERMINATED
}

// User role enum values
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// Account status lookup table
model AccountStatus {
  id        Int               @id @default(autoincrement())
  name      AccountStatusName @unique
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Relations
  users User[]

  @@map("account_statuses")
}

// User model - stores user account information
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  recoveryEmail    String?   @unique @map("recovery_email")
  passwordHash     String    @map("password_hash")
  accountStatusId  Int       @map("account_status_id")
  role             UserRole  @default(USER)
  isVerified       Boolean   @default(false) @map("is_verified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  accountStatus AccountStatus @relation(fields: [accountStatusId], references: [id])
  sessions      Session[]
  otp           Otp?
  profile       Profile?

  // Soft delete index
  @@index([deletedAt])
  @@map("users")
}

// Session model - stores user refresh tokens
model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  // Indexes
  @@index([userId])
  @@index([deletedAt])
  @@map("sessions")
}

// OTP model - stores user One-Time Passwords in database
model Otp {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("otps")
}

model Policy {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("policies")
}

model Profile {
  id                     Int       @id @default(autoincrement())
  userId                 String    @unique @map("user_id")
  fullName               String    @map("full_name")
  gender                 String
  university             String?
  bio                    String?
  avatarSeed             String    @map("avatar_seed")
  birthday               DateTime
  personalityArchetypeId Int?      @map("personality_archetype_id")
  isCompleted            Boolean   @default(false) @map("is_completed")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalityArchetype PersonalityArchetype? @relation(fields: [personalityArchetypeId], references: [id])
  hobbies              ProfileHobby[]
  photos               ProfilePhoto[]
  answers              UserQuestionnaireAnswer[]

  @@map("profiles")
}

model PersonalityArchetype {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  traits      String[]
  imageUrl    String?   @map("image_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  profiles    Profile[]

  @@map("personality_archetypes")
}

model Hobby {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  category  String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  profiles  ProfileHobby[]

  @@map("hobbies")
}

model ProfileHobby {
  profileId Int @map("profile_id")
  hobbyId   Int @map("hobby_id")

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  hobby   Hobby   @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  @@id([profileId, hobbyId])
  @@map("profile_hobbies")
}

model ProfilePhoto {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model QuestionnaireQuestion {
  id        Int      @id @default(autoincrement())
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  options QuestionnaireOption[]
  answers UserQuestionnaireAnswer[]

  @@map("questionnaire_questions")
}

model QuestionnaireOption {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  question QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  UserQuestionnaireAnswer[]

  @@map("questionnaire_options")
}

model UserQuestionnaireAnswer {
  id               String   @id @default(uuid())
  profileId        Int      @map("profile_id")
  questionId       Int      @map("question_id")
  selectedOptionId Int      @map("selected_option_id")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  profile        Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question       QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionnaireOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([profileId, questionId])
  @@map("user_questionnaire_answers")
}
